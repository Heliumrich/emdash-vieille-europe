---
import { Image, PortableText } from 'emdash/ui';
import { photograph } from '../lib/photographs';
import { imageVariants, ARTICLE_WIDTHS, LIGHTBOX_WIDTHS } from '../lib/image-variants';
const { node } = Astro.props;
const photo = photograph(node);
const [reading, lightbox] = await Promise.all([imageVariants(photo.image, Astro.site, ARTICLE_WIDTHS), imageVariants(photo.image, Astro.site, LIGHTBOX_WIDTHS)]);
---
<figure>
  <a href={lightbox.src || photo.full} data-lightbox data-lightbox-srcset={lightbox.srcset}><Image image={photo.image} quality={80} srcset={reading.srcset} sizes={photo.sizes} /></a>
  {node.caption ? <figcaption>{node.caption}</figcaption> : node.captionBlocks ? <figcaption><PortableText value={node.captionBlocks} /></figcaption> : null}
</figure>
