---
import LinkSignal from './LinkSignal.astro';
import { journalPageHref, type JournalOrder } from '../lib/journal';
interface Props { current: number; total: number; order?: JournalOrder; }
const { current, total, order = 'asc' } = Astro.props;
const pageHref = (page: number) => journalPageHref(page, order);
---
{total > 1 && <nav class="pagination" aria-label="Pages du journal">
  {current > 1
    ? <a class="pagination-direction" href={pageHref(current - 1)} rel="prev"><LinkSignal direction="left" /> <span>Page précédente</span></a>
    : <span class="pagination-direction is-disabled"><LinkSignal direction="left" /> <span>Page précédente</span></span>}
  <ol class="pagination-numbers">
    {Array.from({ length: total }, (_, index) => index + 1).map((page) => <li>
      <a href={pageHref(page)} aria-current={page === current ? 'page' : undefined} aria-label={`Page ${page}${page === current ? ', page actuelle' : ''}`}>{page}</a>
    </li>)}
  </ol>
  {current < total
    ? <a class="pagination-direction" href={pageHref(current + 1)} rel="next"><span>Page suivante</span> <LinkSignal /></a>
    : <span class="pagination-direction is-disabled"><span>Page suivante</span> <LinkSignal /></span>}
</nav>}
