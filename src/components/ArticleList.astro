---
import { formatDate, type Article } from '../lib/content';
import CmsImage from './CmsImage.astro';
import LinkSignal from './LinkSignal.astro';
import { COVER_IMAGE_SIZES } from '../../scripts/images.mjs';
import { imageVariants, THUMBNAIL_WIDTHS } from '../lib/image-variants';
interface Props { articles: Article[]; start?: number; }
const { articles, start = 1 } = Astro.props;
const thumbnails = await Promise.all(articles.map(article => imageVariants(article.image, Astro.site, THUMBNAIL_WIDTHS)));
---
<div class="article-list">
  {articles.map((article, index) => <article class="article-row">
    <div class="article-row-number" aria-hidden="true">{String(start + index).padStart(2, '0')}</div>
    <a class="article-row-image" href={`/blog/${article.slug}/`} tabindex="-1" aria-hidden="true">
      <CmsImage image={article.image || '/images/carnet-ferroviaire.svg'} variants={thumbnails[index]} sizes={COVER_IMAGE_SIZES} alt="" width={480} height={320} />
    </a>
    <div class="article-row-copy">
      <div class="article-meta"><time datetime={article.date}>{formatDate(article.date)}</time><span class="meta-dot" aria-hidden="true">·</span><span>{article.readingMinutes} min de lecture</span></div>
      <h3><a href={`/blog/${article.slug}/`}>{article.title}</a></h3>
      <p>{article.excerpt}</p>
      <a class="text-link" href={`/blog/${article.slug}/`} aria-label={`Lire l’article : ${article.title}`}>Lire le récit <LinkSignal /></a>
    </div>
  </article>)}
</div>
