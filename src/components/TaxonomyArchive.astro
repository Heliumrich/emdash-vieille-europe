---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from './ArticleList.astro';
import Pagination from './Pagination.astro';
import { taxonomyArticles } from '../lib/taxonomy';
interface Props { taxonomy: 'category' | 'tag' }
const { taxonomy } = Astro.props;
const archive = await taxonomyArticles(taxonomy, Astro.params.slug!);
if (!archive) return Astro.rewrite('/404/');
const { term, articles } = archive;
const page = Number(Astro.params.page || 1);
const total = Math.max(1, Math.ceil(articles.length / 10));
---
<BaseLayout title={term.label}>
  <section class="journal-entries shell">
    <header class="section-heading"><div><span class="eyebrow">Le carnet ferroviaire</span><h1>{term.label}</h1></div></header>
    <ArticleList articles={articles.slice((page - 1) * 10, page * 10)} />
    <Pagination basePath={`/${taxonomy}/${term.slug}/`} current={page} total={total} />
  </section>
</BaseLayout>
