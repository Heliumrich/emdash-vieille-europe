---
interface Props { direction?: 'left' | 'right'; }
const { direction = 'right' } = Astro.props;
---
<!-- Crop symmetrically around the closed arm, so its axis is the alignment axis.
     The opened arm overflows upwards while its pivot (6, 21.7) stays fixed. -->
<svg class:list={['link-signal', { 'link-signal-left': direction === 'left' }]} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 124 32" aria-hidden="true" focusable="false">
  <g class="link-signal-arm" fill="#fff" stroke="#aa182e">
    <circle cx="103.358" cy="16" r="12.353" stroke-width="5.67" />
    <rect x="6" y="10.3" width="84.717" height="11.4" stroke-width="5.42" />
  </g>
</svg>
