---
import { getEmDashEntry } from 'emdash';
import ArticlePage from '../../components/ArticlePage.astro';
export { getStaticPaths } from '../../../scripts/post-paths';
const { entry, error } = await getEmDashEntry('posts', Astro.params.slug!);
if (error) throw error;
if (!entry) { if (Astro.isPrerendered) throw new Error('Published post changed during build'); return Astro.rewrite('/404/'); }
---
<ArticlePage entry={entry} />
