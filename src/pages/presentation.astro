---
import { getEmDashEntry } from 'emdash';
import PresentationPage from '../components/PresentationPage.astro';
const { entry, error } = await getEmDashEntry('pages', 'presentation');
if (error) throw error;
if (!entry) { if (Astro.isPrerendered) throw new Error('Presentation missing'); return Astro.rewrite('/404/'); }
---
<PresentationPage entry={entry} />
