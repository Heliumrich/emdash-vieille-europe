---
import { getEmDashEntry } from 'emdash';
import ContentPage from '../components/ContentPage.astro';
import { publishedPaths } from '../../scripts/content-paths';
export async function getStaticPaths() { return (await publishedPaths('pages')).filter(path => path.params.slug !== 'presentation'); }
const { entry, error } = await getEmDashEntry('pages', Astro.params.slug!);
if (error) throw error;
if (!entry) { if (Astro.isPrerendered) throw new Error('Published page changed during build'); return Astro.rewrite('/404/'); }
---
<ContentPage entry={entry} />
