---
import { search } from 'emdash';
import BaseLayout from '../layouts/BaseLayout.astro';
const query = Astro.url.searchParams.get('q')?.trim() || '';
const { items } = query ? await search(query, { collections: ['posts'], limit: 50 }) : { items: [] };
---
<BaseLayout title="Rechercher dans le journal" noindex>
  <section class="shell journal-entries">
    <header class="section-heading"><h1>Rechercher dans le journal</h1></header>
    <form action="/search/" method="get" role="search" class="journal-search">
      <label for="q">Un train, une marque, un souvenir…</label>
      <input type="search" name="q" id="q" value={query} required />
      <button class="button-link" type="submit">Rechercher</button>
    </form>
    {query && <p>{items.length} résultat{items.length === 1 ? '' : 's'}</p>}
    <ul class="search-results">{items.map(item => <li><h2><a href={`/blog/${item.slug}/`}>{item.title}</a></h2></li>)}</ul>
  </section>
</BaseLayout>
